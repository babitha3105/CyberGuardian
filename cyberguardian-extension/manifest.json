{
  "manifest_version": 3,
  "name": "CyberGuardian",
  "version": "1.0",
  "description": "Web Threat Detection and Intelligent Parent Alert System ",

  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  }
}